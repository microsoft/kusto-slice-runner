@page "/jobs/{jobId:guid}/soft-delete-confirm"
@model Ksr.LocalApp.Pages.Catalog.SoftDeleteConfirmModel
@{
    ViewData["Title"] = "Soft delete";
    var hasDependents = Model.Dependents.Count > 0;
}

<div class="page-heading">
    <div>
        <h1>Soft delete @Model.ActivityId</h1>
        <p class="muted">Soft delete hides this job from the active catalog but keeps its history, so it can be restored later.</p>
    </div>
    <a class="btn" href="/jobs/@Uri.EscapeDataString(Model.JobId)">Back to job</a>
</div>

<section class="card form-card">
    @if (hasDependents)
    {
        <div class="alert danger">
            <h2>Active jobs depend on this job</h2>
            <p>The following active job(s) list <strong>@Model.ActivityId</strong> as an upstream dependency. Soft-deleting it will break their dependency:</p>
            <ul>
                @foreach (var dependent in Model.Dependents)
                {
                    <li><a href="/jobs/@Uri.EscapeDataString(dependent.JobId)">@dependent.ActivityId</a></li>
                }
            </ul>
        </div>
    }
    else
    {
        <h2>Confirm soft delete</h2>
        <p>No active jobs depend on this job.</p>
    }
    <form method="post" action="/jobs/@Uri.EscapeDataString(Model.JobId)/actions/soft-delete" class="inline-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="expectedVersion" value="@Model.CatalogVersion" />
        <input type="hidden" name="reason" value="Soft deleted from web UI" />
        <input type="hidden" name="force" value="true" />
        <button class="btn danger" type="submit">@(hasDependents ? "Soft delete anyway" : "Soft delete")</button>
        <a class="btn" href="/jobs/@Uri.EscapeDataString(Model.JobId)">Cancel</a>
    </form>
</section>
