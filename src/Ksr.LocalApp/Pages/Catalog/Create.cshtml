@page "/jobs/new"
@model Ksr.LocalApp.Pages.Catalog.CreateModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.ErrorMessage) ? "New job" : "Create job";
}

<div class="page-heading">
    <div>
        <h1>Create job</h1>
        <p class="muted">@(string.IsNullOrWhiteSpace(Model.ErrorMessage) ? "Create a local Kusto Slice Runner job definition." : "Fix validation errors and submit again.")</p>
    </div>
    <a class="btn" href="/">Back to jobs</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert danger">@Model.ErrorMessage</div>
}

<partial name="_ScheduleEditor" model="Model.Editor" />
