<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - KO Lite</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <partial name="_IconSprite" />
    <header class="topbar">
        <a class="brand" href="/">
            <img class="brand-logo" src="~/favicon.svg" asp-append-version="true" alt="" aria-hidden="true" />
            <span>KO Lite</span>
        </a>
        <nav>
            <a href="/">Jobs</a>
            <a href="/catalog/new">New job</a>
            <a href="/catalog/import">Import</a>
            <a href="/status/health">Health</a>
        </nav>
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
