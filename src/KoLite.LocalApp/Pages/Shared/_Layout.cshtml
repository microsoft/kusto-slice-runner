<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Kusto Slice Runner</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <partial name="_IconSprite" />
    <header class="topbar">
        <a class="brand" href="/" aria-label="Kusto Slice Runner">KSR</a>
        <nav>
            <a href="/">Jobs</a>
            <a href="/activity">Activity</a>
            <a href="/api/v1/system/status">Health</a>
        </nav>
        <partial name="_UpdateBadge" />
    </header>
    <main class="container">
        @RenderBody()
    </main>
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/lib/cytoscape/cytoscape.min.js" asp-append-version="true"></script>
    <script src="~/lib/cytoscape/cytoscape-dagre.js" asp-append-version="true"></script>
    <script src="~/lib/marked/marked.umd.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
