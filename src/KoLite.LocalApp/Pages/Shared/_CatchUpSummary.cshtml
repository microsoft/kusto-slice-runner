@using System.Globalization
@using KoLite.Local.Core.Scheduling
@model CatchUpProjection
@{
    if (!Model.ShouldDisplay)
    {
        return;
    }

    var ci = CultureInfo.InvariantCulture;
    var notKeepingUp = Model.Status == CatchUpStatus.NotKeepingUp;
    var collectingData = Model.Status == CatchUpStatus.InsufficientData;
    var cardClass = notKeepingUp ? "card catch-up-card catch-up-warning" : "card catch-up-card catch-up-info";
    var badgeClass = notKeepingUp ? "badge-warning" : "badge-info";
    var badgeText = notKeepingUp ? "Not keeping up" : "Catching up";

    string headline;
    if (notKeepingUp)
    {
        headline = "Backlog is not shrinking at the recent rate";
    }
    else if (collectingData)
    {
        headline = "Collecting data to estimate catch-up time";
    }
    else
    {
        headline = $"{(Model.ProjectedCatchUp is { } projected ? AppFormatting.ApproxDuration(projected) : "")} to catch up";
    }

    var slicesBehindText = Model.BacklogSlices.ToString("N0", ci);
    var dataBehindText = AppFormatting.ApproxDuration(Model.BacklogDataTime);
    string? rateText = Model.SlicesPerHour is { } perHour && Model.RealTimeMultiple is { } multiple
        ? $"~{perHour.ToString("0.#", ci)} slices/h ({multiple.ToString("0.#", ci)}\u00d7 real time)"
        : null;
    string? remainingText = Model.ProjectedCatchUp is { } remaining ? AppFormatting.ApproxDuration(remaining) : null;
    var targetText = AppFormatting.Iso(Model.TargetFrontierUtc);

    // Concrete gating, surfaced so the operator knows exactly what the card is waiting for.
    var requiredSamples = Model.RequiredThroughputSamples.ToString("N0", ci);
    var requiredSpanText = AppFormatting.ApproxDuration(Model.RequiredThroughputSpan);
    var collectedText = $"{Model.ObservedThroughputSamples.ToString("N0", ci)} of {requiredSamples} completions";

    // When recent slices are parked on an upstream dependency they are excluded from the backlog;
    // call that out so the reported "slices behind" is not mistaken for the full real-time gap.
    string? blockedNote = Model.BacklogBlockedSlices > 0
        ? $" {Model.BacklogBlockedSlices.ToString("N0", ci)} more recent slice(s) are waiting on upstream dependencies and are not counted as backlog."
        : null;

    string note;
    if (notKeepingUp)
    {
        note = $"At the recent processing rate this job will not catch up to its target frontier ({targetText}). Investigate failures, throughput, or parallelism.";
    }
    else if (collectingData)
    {
        var reason = Model.ThroughputWindowBoundedByDefinitionChange
            ? "This job's definition changed recently, so KO Lite is collecting fresh execution data under the new definition"
            : "KO Lite is collecting recent execution data";
        note = $"{reason} before it can project a catch-up time. The estimate appears once at least {requiredSamples} slices complete successfully over at least {requiredSpanText}.";
    }
    else
    {
        note = $"Projected to reach its normal delay-bounded frontier ({targetText}). It never reaches the literal current time because of the configured delay.";
    }

    note += blockedNote;
}
<section class="@cardClass" aria-label="Catch-up estimate">
    <div class="catch-up-header">
        <span class="badge @badgeClass">@badgeText</span>
        <span class="catch-up-headline">@headline</span>
    </div>
    <dl class="catch-up-detail">
        <div class="catch-up-metric">
            <dt>Slices behind</dt>
            <dd>@slicesBehindText</dd>
        </div>
        <div class="catch-up-metric">
            <dt>Data behind</dt>
            <dd>@dataBehindText</dd>
        </div>
        @if (rateText is not null)
        {
            <div class="catch-up-metric">
                <dt>Processing rate</dt>
                <dd>@rateText</dd>
            </div>
        }
        @if (collectingData)
        {
            <div class="catch-up-metric">
                <dt>Data collected</dt>
                <dd>@collectedText</dd>
            </div>
        }
        @if (remainingText is not null)
        {
            <div class="catch-up-metric">
                <dt>Estimated time remaining</dt>
                <dd>@remainingText</dd>
            </div>
        }
        @if (Model.EtaUtc is { } eta)
        {
            <div class="catch-up-metric">
                <dt>Estimated caught up</dt>
                <dd>@AppFormatting.Local(eta)</dd>
            </div>
        }
        @if (Model.CompletedFrontierUtc is { } frontier)
        {
            <div class="catch-up-metric">
                <dt>Completed through</dt>
                <dd class="mono">@AppFormatting.Iso(frontier)</dd>
            </div>
        }
    </dl>
    <p class="muted catch-up-note">@note</p>
</section>
