@inject KoLite.LocalApp.Updates.UpdateBadgeReadModel UpdateBadge
@{
    var badge = UpdateBadge.Get();
}
<div class="update-badge update-badge-@badge.StatusKey">
    <button type="button" class="update-badge-button" aria-haspopup="true" aria-expanded="false" title="@badge.Title">
        <span class="update-badge-dot" aria-hidden="true"></span>
        <span class="update-badge-label">@badge.Label</span>
    </button>
    <div class="update-badge-popover" role="dialog" aria-label="Update status">
        <div class="update-badge-popover-title">@badge.Title</div>
        <ul class="update-badge-detail">
            @foreach (var line in badge.DetailLines)
            {
                <li>@line</li>
            }
        </ul>
        @if (badge.HasRemediation)
        {
            <div class="update-badge-remediation">
                <div class="update-badge-remediation-title">@badge.RemediationTitle</div>
                <ul>
                    @foreach (var step in badge.RemediationSteps)
                    {
                        <li>@step</li>
                    }
                </ul>
            </div>
        }
        <div class="update-badge-links">
            @if (badge.ShowLink)
            {
                <a href="@badge.LinkUrl" target="_blank" rel="noopener noreferrer">View release on GitHub</a>
            }
            <a href="/status/health">Details in Health</a>
        </div>
    </div>
</div>
