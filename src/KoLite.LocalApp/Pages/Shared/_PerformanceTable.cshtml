@using KoLite.Local.Core.Performance
@model PerformancePageData
@{
    var state = Model.State;
    var ci = System.Globalization.CultureInfo.InvariantCulture;

    void RenderValues(PerformanceAggregateRow row, string rowHeader)
    {
        <td class="performance-number" headers="@rowHeader performance-col-success">
            <strong>@PerformanceFormatting.Success(row)</strong>
            <span class="performance-subline">@PerformanceFormatting.Count(row.SucceededAttempts) / @PerformanceFormatting.Count(row.CompletedAttempts)</span>
        </td>
        foreach (var metric in PerformanceMetrics.All)
        {
            foreach (var percentile in PerformanceMetrics.Percentiles)
            {
                var key = metric.Key + "-" + percentile;
                var value = metric.Value(row, percentile);
                var tooltip = PerformanceFormatting.MetricTooltip(row, metric, percentile);
                <td class="performance-number @(percentile == "p50" ? "performance-group-start" : null)" headers="@rowHeader @("performance-group-" + metric.Key) @("performance-col-" + key)" data-performance-metric="@key" title="@tooltip" aria-label="@tooltip">@PerformanceFormatting.Value(value, metric.Unit)</td>
            }
        }
    }
}

<p class="muted">Percentiles describe successful query attempts. Job rows pool their chunks; missing measurements show <strong>n/a</strong>.</p>
@if (Model.Jobs.Count == 0)
{
    <p class="empty">@(state.HasFilters ? "No jobs with completed attempts match the selected filters." : "No completed attempts in this period.")</p>
}
else
{
    <p class="muted" id="performance-filter-status" data-performance-filter-status role="status" aria-live="polite">Showing @Model.VisibleJobCount of @Model.Jobs.Count job(s).</p>
    <p class="muted performance-scroll-hint" id="performance-scroll-help">Scroll horizontally to see all nine resource statistics. The job column stays visible.</p>
    <div class="table-wrap performance-table-wrap" tabindex="0" role="region" aria-label="Historical job performance" aria-describedby="performance-statistics-help performance-scroll-help">
        <table class="ko-table compact performance-table" data-performance-table>
            <caption class="visually-hidden">Attempt success and successful query-attempt resource percentiles by job and chunk</caption>
            <colgroup>
                <col class="performance-job-column" />
                <col class="performance-success-column" />
            </colgroup>
            @foreach (var metric in PerformanceMetrics.All)
            {
                <colgroup span="3" class="performance-metric-columns"></colgroup>
            }
            <thead>
                <tr>
                    <th class="performance-job-cell" id="performance-col-activity" scope="col" rowspan="2" aria-sort="@state.SortAria("activity")">
                        <a class="sort-link" href="@state.SortHref("activity")" aria-label="Sort jobs by job name" data-performance-state-link="true">Job <span class="sort-indicator" aria-hidden="true">@state.SortIndicator("activity")</span></a>
                    </th>
                    <th id="performance-col-success" scope="col" rowspan="2" aria-sort="@state.SortAria("success")">
                        <a class="sort-link" href="@state.SortHref("success")" aria-label="Sort jobs by attempt success percentage" data-performance-state-link="true">Attempt success <span class="sort-indicator" aria-hidden="true">@state.SortIndicator("success")</span></a>
                    </th>
                    @foreach (var metric in PerformanceMetrics.All)
                    {
                        <th class="performance-group-heading performance-group-start" id="@("performance-group-" + metric.Key)" scope="colgroup" colspan="3">@metric.Label (@metric.Unit)</th>
                    }
                </tr>
                <tr>
                    @foreach (var metric in PerformanceMetrics.All)
                    {
                        @foreach (var percentile in PerformanceMetrics.Percentiles)
                        {
                            var key = metric.Key + "-" + percentile;
                            <th class="@(percentile == "p50" ? "performance-group-start" : null)" id="@("performance-col-" + key)" scope="col" headers="@("performance-group-" + metric.Key)" aria-sort="@state.SortAria(key)">
                                <a class="sort-link" href="@state.SortHref(key)" aria-label="@($"Sort jobs by {metric.Label} {percentile.ToUpperInvariant()} ({metric.Unit})")" data-performance-sort="@key" data-performance-state-link="true">@percentile.ToUpperInvariant() <span class="sort-indicator" aria-hidden="true">@state.SortIndicator(key)</span></a>
                            </th>
                        }
                    }
                </tr>
            </thead>
            @foreach (var job in Model.Jobs)
            {
                var rowHeader = "performance-job-" + job.JobId;
                var controls = string.Join(" ", job.Chunks.Select(chunk => $"performance-chunk-{job.JobId}-{chunk.ChunkId}"));
                <tbody data-performance-job-id="@job.JobId" data-performance-search="@job.ActivityId"
                       data-performance-eligible-attempts="@job.Total.Coverage.EligibleAttempts.ToString(ci)"
                       data-performance-missing-attempts="@job.Total.Coverage.MissingAttempts.ToString(ci)"
                       hidden="@(!job.MatchesSearch(state.Search))">
                    <tr>
                        <th class="performance-job-cell" scope="row" id="@rowHeader">
                            <div class="performance-job-heading">
                                @if (job.ConfiguredChunks is not null)
                                {
                                    <button type="button" class="performance-disclosure" aria-expanded="false" aria-controls="@controls" aria-label="@($"Show chunks for {job.ActivityId}")" title="Show chunk details" data-performance-disclosure data-performance-job-name="@job.ActivityId"><span class="visually-hidden">Show chunks</span></button>
                                }
                                <a class="strong text-truncate" href="/jobs/@Uri.EscapeDataString(job.JobId)" title="@job.ActivityId">@job.ActivityId</a>
                            </div>
                            @if (job.ConfiguredChunks is { } count)
                            {
                                <span class="performance-subline">@count chunk(s)</span>
                            }
                        </th>
                        @{ RenderValues(job.Total, rowHeader); }
                    </tr>
                    @foreach (var chunk in job.Chunks)
                    {
                        var chunkHeader = $"performance-chunk-label-{job.JobId}-{chunk.ChunkId}";
                        <tr class="performance-chunk-row" id="@($"performance-chunk-{job.JobId}-{chunk.ChunkId}")" data-performance-chunk-row data-performance-chunk-id="@chunk.ChunkId" hidden>
                            <th class="performance-job-cell" scope="row" id="@chunkHeader">Chunk @chunk.ChunkId</th>
                            @{ RenderValues(chunk, chunkHeader); }
                        </tr>
                    }
                </tbody>
            }
        </table>
    </div>
    <p class="empty" data-performance-no-matches hidden="@(Model.VisibleJobCount > 0)">No jobs match the job-name filter.</p>
    <noscript><p class="muted">JavaScript is required to expand chunk rows. Job totals and submitted filters remain available.</p></noscript>
}
