@model JobTableViewModel

@{
    var tableCss = Model.ShowProgressColumn ? "ko-table job-table" : "ko-table job-table job-table-dashboard";
    var enableDashboardFeatures = Model.EnableClientFilter || Model.EnableColumnResize;

    string sortHref(string key)
    {
        var descending = Model.Sort is not null && string.Equals(Model.Sort.Key, key, StringComparison.Ordinal) && !Model.Sort.Descending;
        var prefix = string.IsNullOrEmpty(Model.SortBaseQuery) ? string.Empty : Model.SortBaseQuery + "&";
        return $"/?{prefix}sort={key}&dir={(descending ? "desc" : "asc")}";
    }

    string sortIndicator(string key) => Model.Sort is not null && string.Equals(Model.Sort.Key, key, StringComparison.Ordinal) ? (Model.Sort.Descending ? "\u25be" : "\u25b4") : string.Empty;

    string sortAria(string key) => Model.Sort is not null && string.Equals(Model.Sort.Key, key, StringComparison.Ordinal) ? (Model.Sort.Descending ? "descending" : "ascending") : "none";
}

<section class="card @Model.SectionCssClass" data-dashboard-job-section="@enableDashboardFeatures.ToString().ToLowerInvariant()" data-dashboard-section-key="@Model.TableKey">
    <div class="card-header">
        <h2>@Model.Title</h2>
        <div class="button-row">
            <span class="muted" data-dashboard-section-count="@Model.EnableClientFilter.ToString().ToLowerInvariant()" data-dashboard-original-count="@Model.Jobs.Count">@Model.Jobs.Count job(s)</span>
            @if (!string.IsNullOrWhiteSpace(Model.HeaderActionHref) && !string.IsNullOrWhiteSpace(Model.HeaderActionText))
            {
                <a class="btn small" href="@Model.HeaderActionHref">@Model.HeaderActionText</a>
            }
        </div>
    </div>
    @if (Model.Jobs.Count == 0)
    {
        <p class="empty">No jobs in this section.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="@tableCss" data-dashboard-job-table="@Model.EnableClientFilter.ToString().ToLowerInvariant()" data-dashboard-resizable="@Model.EnableColumnResize.ToString().ToLowerInvariant()" data-dashboard-section-key="@Model.TableKey">
                <colgroup>
                    @if (Model.EnableBulkSelect)
                    {
                        <col class="job-col-select" data-column-key="select" data-default-width="40" data-min-width="40" />
                    }
                    <col class="job-col-status" data-column-key="status" data-default-width="88" data-min-width="72" />
                    <col class="job-col-activity" data-column-key="activity" data-default-width="324" data-min-width="160" />
                    @if (Model.ShowDefinitionColumns)
                    {
                        <col class="job-col-function" data-column-key="function" data-default-width="240" data-min-width="160" />
                    }
                    <col class="job-col-schedule" data-column-key="schedule" data-default-width="112" data-min-width="90" />
                    @if (Model.ShowProgressColumn)
                    {
                        <col class="job-col-progress" data-column-key="progress" data-default-width="210" data-min-width="140" />
                    }
                    @if (Model.ShowNextEligibleColumn)
                    {
                        <col class="job-col-next" data-column-key="next" data-default-width="170" data-min-width="130" />
                    }
                    @if (Model.ShowUpdatedColumn)
                    {
                        <col class="job-col-updated" data-column-key="updated" data-default-width="150" data-min-width="120" />
                    }
                    <col class="job-col-actions" data-column-key="actions" data-default-width="160" data-min-width="84" />
                </colgroup>
                <thead>
                    <tr>
                        @if (Model.EnableBulkSelect)
                        {
                            <th class="select-col"><input type="checkbox" class="bulk-select-all" data-bulk-select-all data-bulk-section="@Model.TableKey" aria-label="Select all jobs in @Model.Title" /></th>
                        }
                        <th data-dashboard-column-key="@(Model.EnableColumnResize ? "status" : null)" aria-sort="@(Model.EnableSort ? sortAria("status") : null)">
                            @if (Model.EnableSort)
                            {
                                <a class="sort-link" href="@sortHref("status")">Status <span class="sort-indicator" aria-hidden="true">@sortIndicator("status")</span></a>
                            }
                            else
                            {
                                @:Status
                            }
                            @if (Model.EnableColumnResize)
                            {
                                <button class="column-resize-handle" type="button" data-column-key="status" aria-label="Resize Status column" title="Resize Status column"></button>
                            }
                        </th>
                        <th data-dashboard-column-key="@(Model.EnableColumnResize ? "activity" : null)" aria-sort="@(Model.EnableSort ? sortAria("activity") : null)">
                            @if (Model.EnableSort)
                            {
                                <a class="sort-link" href="@sortHref("activity")">Activity <span class="sort-indicator" aria-hidden="true">@sortIndicator("activity")</span></a>
                            }
                            else
                            {
                                @:Activity
                            }
                            @if (Model.EnableColumnResize)
                            {
                                <button class="column-resize-handle" type="button" data-column-key="activity" aria-label="Resize Activity column" title="Resize Activity column"></button>
                            }
                        </th>
                        @if (Model.ShowDefinitionColumns)
                        {
                            @if (Model.EnableColumnResize)
                            {
                                <th data-dashboard-column-key="function">Function / Output<button class="column-resize-handle" type="button" data-column-key="function" aria-label="Resize Function / Output column" title="Resize Function / Output column"></button></th>
                            }
                            else
                            {
                                <th>Function / Output</th>
                            }
                        }
                        <th data-dashboard-column-key="@(Model.EnableColumnResize ? "schedule" : null)" aria-sort="@(Model.EnableSort ? sortAria("schedule") : null)">
                            @if (Model.EnableSort)
                            {
                                <a class="sort-link" href="@sortHref("schedule")">Schedule <span class="sort-indicator" aria-hidden="true">@sortIndicator("schedule")</span></a>
                            }
                            else
                            {
                                @:Schedule
                            }
                            @if (Model.EnableColumnResize)
                            {
                                <button class="column-resize-handle" type="button" data-column-key="schedule" aria-label="Resize Schedule column" title="Resize Schedule column"></button>
                            }
                        </th>
                        @if (Model.ShowProgressColumn)
                        {
                            @if (Model.EnableColumnResize)
                            {
                                <th data-dashboard-column-key="progress">Progress<button class="column-resize-handle" type="button" data-column-key="progress" aria-label="Resize Progress column" title="Resize Progress column"></button></th>
                            }
                            else
                            {
                                <th>Progress</th>
                            }
                        }
                        @if (Model.ShowNextEligibleColumn)
                        {
                            <th data-dashboard-column-key="@(Model.EnableColumnResize ? "next" : null)" aria-sort="@(Model.EnableSort ? sortAria("next") : null)">
                                @if (Model.EnableSort)
                                {
                                    <a class="sort-link" href="@sortHref("next")">Next eligible <span class="sort-indicator" aria-hidden="true">@sortIndicator("next")</span></a>
                                }
                                else
                                {
                                    @:Next eligible
                                }
                                @if (Model.EnableColumnResize)
                                {
                                    <button class="column-resize-handle" type="button" data-column-key="next" aria-label="Resize Next eligible column" title="Resize Next eligible column"></button>
                                }
                            </th>
                        }
                        @if (Model.ShowUpdatedColumn)
                        {
                            @if (Model.EnableColumnResize)
                            {
                                <th data-dashboard-column-key="updated">Updated<button class="column-resize-handle" type="button" data-column-key="updated" aria-label="Resize Updated column" title="Resize Updated column"></button></th>
                            }
                            else
                            {
                                <th>Updated</th>
                            }
                        }
                        @if (Model.EnableColumnResize)
                        {
                            <th class="actions" data-dashboard-column-key="actions">Actions<button class="column-resize-handle" type="button" data-column-key="actions" aria-label="Resize Actions column" title="Resize Actions column"></button></th>
                        }
                        else
                        {
                            <th class="actions">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                @foreach (var job in Model.Jobs)
                {
                    var dashboardSearchText = Model.EnableClientFilter ? BuildDashboardSearchText(Model, job) : null;
                    var inlineToggle = Model.EnableInlineToggle;
                    var toggleBase = "/jobs/" + Uri.EscapeDataString(job.Record.JobId) + "/actions";
                    <tr data-dashboard-job-row="@Model.EnableClientFilter.ToString().ToLowerInvariant()" data-dashboard-job-id="@job.Record.JobId" data-dashboard-search="@dashboardSearchText">
                        @if (Model.EnableBulkSelect)
                        {
                            <td class="select-cell"><input type="checkbox" class="bulk-select" data-bulk-select value="@job.Record.JobId" data-expected-version="@job.Record.CatalogVersion" aria-label="Select @job.Record.ActivityId" /></td>
                        }
                        <td class="status-cell">
                            <partial name="_StatusPill" model="job" />
                        </td>
                        <td class="activity-cell">
                            <a class="strong text-truncate" title="@job.Record.ActivityId" href="/jobs/@Uri.EscapeDataString(job.Record.JobId)">@job.Record.ActivityId</a>
                            @if (Model.ShowFolderLine && !string.IsNullOrWhiteSpace(job.Definition.Folder))
                            {
                                <div class="muted text-truncate" title="@job.Definition.Folder">@job.Definition.Folder</div>
                            }
                        </td>
                        @if (Model.ShowDefinitionColumns)
                        {
                            <td class="function-cell">
                                <div class="text-truncate" title="@job.Definition.FunctionName">@job.Definition.FunctionName</div>
                                <div class="muted text-truncate" title="@job.Definition.OutputTable">@job.Definition.OutputTable</div>
                            </td>
                        }
                        <td class="schedule-cell">
                            <div>@AppFormatting.Duration(job.Definition.QueryWindowSize)</div>
                            <div class="muted">Delay @AppFormatting.Duration(job.Definition.DelayFromUtcNow)</div>
                        </td>
                        @if (Model.ShowProgressColumn)
                        {
                            <td class="progress-cell">
                                @if (job.Summary is null)
                                {
                                    <span class="muted">No slices yet</span>
                                }
                                else
                                {
                                    <div>@job.Summary.CompletedCount completed / @job.TotalSlices total</div>
                                    @if (Model.ShowRunningProgressCount)
                                    {
                                        <div class="muted">@job.Summary.QueuedCount queued, @job.Summary.RunningCount running, @job.FailedSlices failed, @job.WaitingOnDependencySlices waiting</div>
                                    }
                                    else
                                    {
                                        <div class="muted">@job.Summary.QueuedCount queued, @job.FailedSlices failed, @job.WaitingOnDependencySlices waiting</div>
                                    }
                                }
                            </td>
                        }
                        @if (Model.ShowNextEligibleColumn)
                        {
                            <td class="next-cell" title="@job.NextSlice.Detail">@job.NextSlice.Text</td>
                        }
                        @if (Model.ShowUpdatedColumn)
                        {
                            <td class="updated-cell">@AppFormatting.Iso(job.Summary?.LastUpdatedAtUtc ?? job.Record.UpdatedAtUtc)</td>
                        }
                        <td class="actions">
                            <div class="action-group">
                                <a class="btn small icon-only" title="Edit" aria-label="Edit" href="/jobs/@Uri.EscapeDataString(job.Record.JobId)">@UiIcons.IconOnly("edit", "Edit")</a>
                                @if (Model.ShowHistoryAction)
                                {
                                    <a class="btn small icon-only" title="History" aria-label="History" href="/jobs/@Uri.EscapeDataString(job.Record.JobId)/history">@UiIcons.IconOnly("history", "History")</a>
                                }
                                <a class="btn small icon-only" title="Copy" aria-label="Copy" href="/jobs/@Uri.EscapeDataString(job.Record.JobId)/copy">@UiIcons.IconOnly("copy", "Copy")</a>
                                @if (Model.SoftDeletedSection)
                                {
                                    <form method="post" action="/jobs/@Uri.EscapeDataString(job.Record.JobId)/actions/restore" class="inline-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="expectedVersion" value="@job.Record.CatalogVersion" />
                                        <input type="hidden" name="reason" value="Restored from dashboard" />
                                        <button class="btn small icon-only" type="submit" title="Restore" aria-label="Restore">@UiIcons.IconOnly("restore", "Restore")</button>
                                    </form>
                                    <a class="btn small icon-only danger" title="Hard delete" aria-label="Hard delete" href="/jobs/@Uri.EscapeDataString(job.Record.JobId)/hard-delete">@UiIcons.IconOnly("hard-delete", "Hard delete")</a>
                                }
                                else
                                {
                                    @if (job.Record.IsEnabled)
                                    {
                                        <form method="post" action="@toggleBase/pause" class="inline-form" data-dashboard-toggle="@(inlineToggle ? "true" : null)" data-dashboard-job-id="@(inlineToggle ? job.Record.JobId : null)" data-toggle-base="@(inlineToggle ? toggleBase : null)">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="expectedVersion" value="@job.Record.CatalogVersion" />
                                            <button class="btn small icon-only" type="submit" title="Pause" aria-label="Pause">@UiIcons.IconOnly("pause", "Pause")</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" action="@toggleBase/resume" class="inline-form" data-dashboard-toggle="@(inlineToggle ? "true" : null)" data-dashboard-job-id="@(inlineToggle ? job.Record.JobId : null)" data-toggle-base="@(inlineToggle ? toggleBase : null)">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="expectedVersion" value="@job.Record.CatalogVersion" />
                                            <button class="btn small icon-only" type="submit" title="Resume" aria-label="Resume">@UiIcons.IconOnly("play", "Resume")</button>
                                        </form>
                                    }
                                    @if (Model.ShowSoftDeleteAction)
                                    {
                                        <form method="post" action="/jobs/@Uri.EscapeDataString(job.Record.JobId)/actions/soft-delete" class="inline-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="expectedVersion" value="@job.Record.CatalogVersion" />
                                            <input type="hidden" name="reason" value="Soft deleted from dashboard" />
                                            <button class="btn small icon-only danger" type="submit" title="Soft delete" aria-label="Soft delete">@UiIcons.IconOnly("trash", "Soft delete")</button>
                                        </form>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            @if (Model.EnableClientFilter)
            {
                <p class="empty dashboard-filter-empty" data-dashboard-filter-empty="true" hidden>No jobs match the text filter in this section.</p>
            }
        </div>
    }
</section>

@functions {
    private static string BuildDashboardSearchText(JobTableViewModel model, JobListItem job)
    {
        var parts = new List<string?>
        {
            job.Record.ActivityId,
            job.StatusText,
            job.ShowCompleteness ? AppFormatting.CompletenessLabel(job.GapCount) : null,
            AppFormatting.Duration(job.Definition.QueryWindowSize),
            "Delay " + AppFormatting.Duration(job.Definition.DelayFromUtcNow)
        };

        if (model.ShowFolderLine)
        {
            parts.Add(job.Definition.Folder);
        }

        if (model.ShowDefinitionColumns)
        {
            parts.Add(job.Definition.FunctionName);
            parts.Add(job.Definition.OutputTable);
        }

        if (model.ShowProgressColumn)
        {
            if (job.Summary is null)
            {
                parts.Add("No slices yet");
            }
            else
            {
                parts.Add(job.Summary.CompletedCount + " completed");
                parts.Add(job.TotalSlices + " total");
                parts.Add(job.Summary.QueuedCount + " queued");
                if (model.ShowRunningProgressCount)
                {
                    parts.Add(job.Summary.RunningCount + " running");
                }

                parts.Add(job.FailedSlices + " failed");
                parts.Add(job.WaitingOnDependencySlices + " waiting");
            }
        }

        if (model.ShowNextEligibleColumn)
        {
            parts.Add(job.NextSlice.Text);
            parts.Add(job.NextSlice.Detail);
        }

        if (model.ShowUpdatedColumn)
        {
            parts.Add(AppFormatting.Iso(job.Summary?.LastUpdatedAtUtc ?? job.Record.UpdatedAtUtc));
        }

        return string.Join(" ", parts.Where(part => !string.IsNullOrWhiteSpace(part))).ToLowerInvariant();
    }
}
