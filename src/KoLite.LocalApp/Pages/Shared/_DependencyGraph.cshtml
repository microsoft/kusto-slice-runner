@using System.Text.Json
@model DependencyGraphPanelViewModel
@{
    var graph = Model.Graph;
}

@if (graph.IsEmpty)
{
    <p class="empty">No jobs to graph. The selected job(s) may have been deleted.</p>
}
else
{
    var labelsById = graph.Nodes.ToDictionary(node => node.Id, node => node.Label, StringComparer.Ordinal);
    var payloadJson = JsonSerializer.Serialize(DependencyGraphPayload.Build(graph));
    var focalIds = string.Join(" ", Model.FocalJobIds.Where(id => !string.IsNullOrWhiteSpace(id)));

    <figure class="dependency-graph" data-dependency-graph data-dependency-graph-focal="@focalIds" aria-label="Job dependency graph">
        <div class="dependency-graph-toolbar">
            <div class="dependency-graph-legend" data-dependency-graph-legend>
                @foreach (var item in graph.Legend)
                {
                    <span class="dependency-graph-legend-item">
                        <span class="dependency-graph-swatch status-@item.Status.ToLowerInvariant()" aria-hidden="true"></span>
                        @item.Label
                    </span>
                }
            </div>
            <div class="dependency-graph-actions">
                <span class="dependency-graph-zoom" role="group" aria-label="Graph zoom">
                    <button type="button" class="btn small" data-dependency-graph-zoom-out aria-label="Zoom out">&minus;</button>
                    <button type="button" class="btn small" data-dependency-graph-zoom-in aria-label="Zoom in">+</button>
                    <button type="button" class="btn small" data-dependency-graph-fit>Fit</button>
                    <button type="button" class="btn small" data-dependency-graph-reset aria-label="Reset zoom to 100%">1:1</button>
                </span>
                <button type="button" class="btn small" data-dependency-graph-resolve>@UiIcons.IconText("graph", "Resolve Kusto lineage")</button>
                <span class="dependency-graph-status muted" data-dependency-graph-status role="status" aria-live="polite"></span>
            </div>
        </div>
        <div class="dependency-graph-body">
            <div class="dependency-graph-viewport" data-dependency-graph-viewport></div>
            <aside class="dependency-graph-inspector" data-dependency-graph-inspector aria-label="Selected node details"></aside>
        </div>
        <div class="dependency-graph-fallback" data-dependency-graph-fallback>
            <p class="muted">Dependency graph (text view):</p>
            <ul class="plain-list">
                @foreach (var node in graph.Nodes)
                {
                    <li>
                        @if (node.Href is not null)
                        {
                            <a href="@node.Href">@node.Label</a>
                        }
                        else
                        {
                            <span>@node.Label</span>
                        }
                        <span class="badge @node.StatusCss">@node.StatusText</span>
                    </li>
                }
            </ul>
            @if (graph.Edges.Count > 0)
            {
                <p class="muted">Dependencies (upstream &rarr; downstream):</p>
                <ul class="plain-list">
                    @foreach (var edge in graph.Edges)
                    {
                        <li>@(labelsById.TryGetValue(edge.FromId, out var fromLabel) ? fromLabel : edge.FromId) &rarr; @(labelsById.TryGetValue(edge.ToId, out var toLabel) ? toLabel : edge.ToId)</li>
                    }
                </ul>
            }
        </div>
        <script type="application/json" class="dependency-graph-payload" data-dependency-graph-data>@Html.Raw(payloadJson)</script>
    </figure>
}
