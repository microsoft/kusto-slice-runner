@page "/activity"
@using KoLite.LocalApp.Ui
@model KoLite.LocalApp.Pages.Activity.IndexModel
@using KoLite.Local.Core.Performance
@{
    ViewData["Title"] = "Activity";
    var ci = System.Globalization.CultureInfo.InvariantCulture;
}

<div class="page-heading">
    <div>
        <h1>Activity</h1>
        @if (Model.IsPerformance)
        {
            <p class="muted">Compare completed query attempts and successful query resource measurements across jobs and chunks.</p>
        }
        else
        {
            <p class="muted">How much work is flowing through Kusto Slice Runner. Logical slices are time windows; execution units are chunks for chunked jobs and slices otherwise.</p>
        }
    </div>
    <div class="button-row">
        <a class="btn" href="@Model.RefreshHref" data-performance-state-link="@(Model.IsPerformance ? "true" : null)">Refresh</a>
    </div>
</div>

<nav class="tab-list activity-view-nav" aria-label="Activity views">
    <a class="tab-link @(!Model.IsPerformance ? "active" : null)" href="/activity" aria-current="@(!Model.IsPerformance ? "page" : null)">Live</a>
    <a class="tab-link @(Model.IsPerformance ? "active" : null)" href="/activity?view=performance&amp;range=7d" aria-current="@(Model.IsPerformance ? "page" : null)">Performance</a>
</nav>

@if (Model.Performance is { } performance)
{
    var state = performance.State;
    <section class="card performance-view" data-performance-root>
        <div class="card-header">
            <h2>Performance</h2>
            <div class="range-picker" aria-label="Performance range">
                @foreach (var range in Model.RangeLinks)
                {
                    <a class="btn small @(range.Key == Model.Range ? "primary" : null)" href="@state.RangeHref(range.Key)" aria-current="@(range.Key == Model.Range ? "true" : null)" data-performance-state-link="true">@range.Label</a>
                }
            </div>
        </div>
        <p class="muted performance-period">
            Completed attempts (UTC):
            <time datetime="@PerformanceFormatting.Timestamp(performance.FromUtc)" title="Inclusive start">@PerformanceFormatting.DisplayTimestamp(performance.FromUtc)</time>
            to
            <time datetime="@PerformanceFormatting.Timestamp(performance.ToUtc)" title="Exclusive end">@PerformanceFormatting.DisplayTimestamp(performance.ToUtc)</time>.
        </p>
        <form method="get" action="/activity" class="performance-filter-form">
            <input type="hidden" name="view" value="performance" />
            <input type="hidden" name="range" value="@state.Range" />
            <input type="hidden" name="sort" value="@state.Sort.Key" />
            <input type="hidden" name="dir" value="@state.Sort.Direction" />
            @if (state.JobId is not null)
            {
                <input type="hidden" name="jobId" value="@state.JobId" />
            }
            @foreach (var tag in state.Tags)
            {
                <input type="hidden" name="tag" value="@tag" />
            }
            <label for="performance-job-filter">
                Job name
                <input class="dashboard-filter-input performance-filter-input" type="search" id="performance-job-filter" name="q" value="@state.Search" placeholder="Filter jobs" autocomplete="off" data-performance-filter-input />
            </label>
            <button class="btn" type="submit">Apply filter</button>
            <a class="btn" href="@state.ClearFiltersHref" data-performance-clear-filters>Clear filters</a>
        </form>
        @if (state.JobId is not null)
        {
            <p class="muted">Selected job: <strong>@(performance.SelectedJobLabel ?? state.JobId)</strong>.</p>
        }
        @if (performance.AvailableTags.Count > 0)
        {
            <div class="performance-tag-filters">
                <span class="muted">Tags (all selected tags must match)</span>
                <div class="tag-list" aria-label="Performance tag filters">
                    @foreach (var tag in performance.AvailableTags)
                    {
                        <a class="tag-chip filter-chip @(tag.IsSelected ? "selected" : null)" href="@state.ToggleTagHref(tag.Name)" aria-pressed="@(tag.IsSelected ? "true" : "false")" data-performance-state-link="true">
                            <span>#@tag.Name</span><span class="tag-count">@tag.JobCount</span>
                        </a>
                    }
                </div>
            </div>
        }
        @if (performance.Collection.HistoryInitialized && performance.FilterError is null)
        {
            var coverage = performance.VisibleCoverage;
            <div class="alert warning" role="status" aria-live="polite" data-performance-coverage-warning
                 data-performance-threshold-percent="@PerformanceCoveragePolicy.ThresholdPercent.ToString(ci)"
                 data-performance-minimum-missing="@PerformanceCoveragePolicy.MinimumMissingAttempts.ToString(ci)"
                 hidden="@(!PerformanceCoveragePolicy.ShouldWarn(coverage))">
                <strong>Resource statistics are incomplete.</strong>
                <span data-performance-coverage-message>@PerformanceFormatting.CoverageMessage(coverage)</span>
                <div class="muted">The newest @PerformanceCoveragePolicy.GracePeriodMinutes minutes and known duplicate-suppressed attempts are excluded. See <a href="#performance-collection-details">Collection details</a> for diagnostics.</div>
            </div>
        }
        @if (performance.FilterError is not null)
        {
            <div class="alert danger" role="alert">@performance.FilterError</div>
        }
        else if (!performance.Collection.HistoryInitialized)
        {
            <div class="alert warning" role="status" data-performance-initializing>
                Initializing retained attempt history. Totals and percentiles are withheld until local history initialization completes.
            </div>
        }
        else
        {
            <partial name="_PerformanceTable" model="performance" />
        }
        <partial name="_PerformanceFooter" model="performance" />
    </section>
}
else if (Model.Data is { } data)
{
    var running = data.RunningNow;
    var totalsCards = new (string Label, ProcessedTotals Totals)[]
    {
        ("Last day", data.LastDay),
        ("Last 7 days", data.Last7Days),
        ("Last 30 days", data.Last30Days),
        ("All time", data.AllTime),
    };

<section class="card section-block">
    <div class="card-header"><h2>Running now</h2></div>
    <div class="activity-metrics">
        <div class="stat-card" data-activity-metric="logical-running">
            <span class="stat-label">Logical slices running</span>
            <span class="activity-metric-value">@running.RunningCount.ToString("N0", ci)</span>
            <span class="muted">time window(s) executing</span>
        </div>
        <div class="stat-card" data-activity-metric="logical-queued">
            <span class="stat-label">Logical slices queued</span>
            <span class="activity-metric-value">@running.QueuedCount.ToString("N0", ci)</span>
            <span class="muted">time window(s) waiting</span>
        </div>
        <div class="stat-card" data-activity-metric="execution-running">
            <span class="stat-label">Executions running</span>
            <span class="activity-metric-value">@running.RunningExecutionCount.ToString("N0", ci)</span>
            <span class="muted">chunk(s) or unchunked slice(s)</span>
        </div>
        <div class="stat-card" data-activity-metric="execution-queued">
            <span class="stat-label">Executions queued/retry-pending</span>
            <span class="activity-metric-value">@running.QueuedExecutionCount.ToString("N0", ci)</span>
            <span class="muted">durable queue row(s)</span>
        </div>
    </div>
    @if (running.RunningSlices.Count == 0)
    {
        <p class="empty">No logical slices are executing right now.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="ko-table">
                <thead>
                    <tr>
                        <th>Job</th>
                        <th>Slice</th>
                        <th>Progress</th>
                        <th>Running executions</th>
                        <th>Highest attempt</th>
                        <th>Started (UTC)</th>
                        <th>ETA (UTC)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var view in running.RunningSlices)
                    {
                        var slice = view.Slice;
                        <tr data-activity-job-id="@slice.JobId">
                            <td><a href="/jobs/@Uri.EscapeDataString(slice.JobId)">@slice.ActivityId</a></td>
                            <td>
                                <a href="/jobs/@Uri.EscapeDataString(slice.JobId)/slices?start=@Uri.EscapeDataString(AppFormatting.Iso(slice.SliceStartUtc))&amp;end=@Uri.EscapeDataString(AppFormatting.Iso(slice.SliceEndUtc))">
                                    @AppFormatting.Iso(slice.SliceStartUtc) &ndash; @AppFormatting.Iso(slice.SliceEndUtc)
                                </a>
                            </td>
                            <td>
                                @if (view.TotalChunks is { } totalChunks)
                                {
                                    <strong data-chunk-progress="@slice.JobId">@view.CompletedChunks/@totalChunks completed</strong>
                                    <div class="activity-progress-badges">
                                        @if (view.RunningChunks > 0) { <span class="badge badge-info">@view.RunningChunks running</span> }
                                        @if (view.QueuedChunks > 0) { <span class="badge badge-neutral">@view.QueuedChunks queued</span> }
                                        @if (view.FailedChunks > 0) { <span class="badge badge-warning">@view.FailedChunks retry-pending</span> }
                                        @if (view.DeadLetteredChunks > 0) { <span class="badge badge-danger">@view.DeadLetteredChunks dead-lettered</span> }
                                        @if (view.MissingChunks > 0) { <span class="badge badge-neutral">@view.MissingChunks not released</span> }
                                    </div>
                                }
                                else
                                {
                                    <span class="muted">Unchunked</span>
                                }
                            </td>
                            <td>
                                @foreach (var execution in view.RunningExecutions)
                                {
                                    <div class="activity-execution-line" data-running-chunk-id="@execution.ChunkId">
                                        <strong>@(execution.ChunkId is { } chunkId && execution.TotalChunks is { } chunks ? $"Chunk {chunkId}/{chunks}" : "Execution")</strong>
                                        <span> &mdash; @(execution.WorkerId ?? "No worker")</span>
                                        @if (execution.LeaseExpired)
                                        {
                                            <span class="badge badge-warning">expired lease</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>@slice.Attempt</td>
                            <td>
                                @AppFormatting.Iso(view.StartedAtUtc)
                                <span class="muted activity-relative">@AppFormatting.RelativeToNow(view.StartedAtUtc, data.GeneratedAtUtc)</span>
                            </td>
                            <td>
                                @if (view.EtaUtc is { } eta)
                                {
                                    @AppFormatting.Iso(eta)
                                    <span class="muted activity-relative">@AppFormatting.RelativeToNow(eta, data.GeneratedAtUtc)</span>
                                }
                                else
                                {
                                    <span class="muted">No history yet</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (running.RunningCount > running.RunningSlices.Count)
        {
            <p class="muted">Showing @running.RunningSlices.Count of @running.RunningCount.ToString("N0", ci) running logical slice(s).</p>
        }
    }
</section>

<section class="card section-block">
    <div class="card-header">
        <div>
            <h2>Executions processed</h2>
            <p class="muted chart-help">Each execution unit contributes its latest succeeded or failed/dead-lettered outcome once.</p>
        </div>
    </div>
    <div class="summary-grid">
        @foreach (var (label, totals) in totalsCards)
        {
            <div class="stat-card">
                <span class="stat-label">@label</span>
                <span class="activity-total-value">@totals.Total.ToString("N0", ci)</span>
                <div class="activity-total-split">
                    <span class="badge badge-success">@totals.Succeeded.ToString("N0", ci) succeeded</span>
                    <span class="badge @(totals.Failed > 0 ? "badge-danger" : "badge-neutral")">@totals.Failed.ToString("N0", ci) failed</span>
                </div>
            </div>
        }
    </div>
</section>

<section class="card section-block">
    <div class="card-header">
        <div>
            <h2>Executions processed over time</h2>
            <p class="muted chart-help">
                Execution units by latest terminal completion, succeeded vs. failed/dead-lettered.
                The chart shows complete UTC-aligned buckets through <span class="mono">@AppFormatting.Iso(data.Chart.RangeEndUtc)</span>; the current incomplete bucket is omitted.
            </p>
        </div>
        <div class="range-picker">
            @foreach (var range in Model.RangeLinks)
            {
                <a class="btn small @(range.Key == Model.Range ? "primary" : null)" href="/activity?range=@range.Key">@range.Label</a>
            }
        </div>
    </div>
    <partial name="_ExecutionsProcessedChart" model="data.Chart" />
</section>
}
