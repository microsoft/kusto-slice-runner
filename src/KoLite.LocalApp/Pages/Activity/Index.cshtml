@page "/activity"
@using KoLite.LocalApp.Ui
@model KoLite.LocalApp.Pages.Activity.IndexModel
@{
    ViewData["Title"] = "Activity";
    var ci = System.Globalization.CultureInfo.InvariantCulture;
    var data = Model.Data;
    var running = data.RunningNow;

    var totalsCards = new (string Label, ProcessedTotals Totals)[]
    {
        ("Last day", data.LastDay),
        ("Last 7 days", data.Last7Days),
        ("Last 30 days", data.Last30Days),
        ("All time", data.AllTime),
    };
}

<div class="page-heading">
    <div>
        <h1>Activity</h1>
        <p class="muted">How much work is flowing through KO Lite. Logical slices are time windows; execution units are chunks for chunked jobs and slices otherwise.</p>
    </div>
    <div class="button-row">
        <a class="btn" href="/activity?range=@Model.Range">Refresh</a>
    </div>
</div>

<section class="card section-block">
    <div class="card-header"><h2>Running now</h2></div>
    <div class="activity-metrics">
        <div class="stat-card" data-activity-metric="logical-running">
            <span class="stat-label">Logical slices running</span>
            <span class="activity-metric-value">@running.RunningCount.ToString("N0", ci)</span>
            <span class="muted">time window(s) executing</span>
        </div>
        <div class="stat-card" data-activity-metric="logical-queued">
            <span class="stat-label">Logical slices queued</span>
            <span class="activity-metric-value">@running.QueuedCount.ToString("N0", ci)</span>
            <span class="muted">time window(s) waiting</span>
        </div>
        <div class="stat-card" data-activity-metric="execution-running">
            <span class="stat-label">Executions running</span>
            <span class="activity-metric-value">@running.RunningExecutionCount.ToString("N0", ci)</span>
            <span class="muted">chunk(s) or unchunked slice(s)</span>
        </div>
        <div class="stat-card" data-activity-metric="execution-queued">
            <span class="stat-label">Executions queued/retry-pending</span>
            <span class="activity-metric-value">@running.QueuedExecutionCount.ToString("N0", ci)</span>
            <span class="muted">durable queue row(s)</span>
        </div>
    </div>
    @if (running.RunningSlices.Count == 0)
    {
        <p class="empty">No logical slices are executing right now.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="ko-table">
                <thead>
                    <tr>
                        <th>Job</th>
                        <th>Slice</th>
                        <th>Progress</th>
                        <th>Running executions</th>
                        <th>Highest attempt</th>
                        <th>Started (UTC)</th>
                        <th>ETA (UTC)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var view in running.RunningSlices)
                    {
                        var slice = view.Slice;
                        <tr data-activity-job-id="@slice.JobId">
                            <td><a href="/jobs/@Uri.EscapeDataString(slice.JobId)">@slice.ActivityId</a></td>
                            <td>
                                <a href="/jobs/@Uri.EscapeDataString(slice.JobId)/slices?start=@Uri.EscapeDataString(AppFormatting.Iso(slice.SliceStartUtc))&amp;end=@Uri.EscapeDataString(AppFormatting.Iso(slice.SliceEndUtc))">
                                    @AppFormatting.Iso(slice.SliceStartUtc) &ndash; @AppFormatting.Iso(slice.SliceEndUtc)
                                </a>
                            </td>
                            <td>
                                @if (view.TotalChunks is { } totalChunks)
                                {
                                    <strong data-chunk-progress="@slice.JobId">@view.CompletedChunks/@totalChunks completed</strong>
                                    <div class="activity-progress-badges">
                                        @if (view.RunningChunks > 0) { <span class="badge badge-info">@view.RunningChunks running</span> }
                                        @if (view.QueuedChunks > 0) { <span class="badge badge-neutral">@view.QueuedChunks queued</span> }
                                        @if (view.FailedChunks > 0) { <span class="badge badge-warning">@view.FailedChunks retry-pending</span> }
                                        @if (view.DeadLetteredChunks > 0) { <span class="badge badge-danger">@view.DeadLetteredChunks dead-lettered</span> }
                                        @if (view.MissingChunks > 0) { <span class="badge badge-neutral">@view.MissingChunks not released</span> }
                                    </div>
                                }
                                else
                                {
                                    <span class="muted">Unchunked</span>
                                }
                            </td>
                            <td>
                                @foreach (var execution in view.RunningExecutions)
                                {
                                    <div class="activity-execution-line" data-running-chunk-id="@execution.ChunkId">
                                        <strong>@(execution.ChunkId is { } chunkId && execution.TotalChunks is { } chunks ? $"Chunk {chunkId}/{chunks}" : "Execution")</strong>
                                        <span> &mdash; @(execution.WorkerId ?? "No worker")</span>
                                        @if (execution.LeaseExpired)
                                        {
                                            <span class="badge badge-warning">expired lease</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>@slice.Attempt</td>
                            <td>
                                @AppFormatting.Iso(view.StartedAtUtc)
                                <span class="muted activity-relative">@AppFormatting.RelativeToNow(view.StartedAtUtc, data.GeneratedAtUtc)</span>
                            </td>
                            <td>
                                @if (view.EtaUtc is { } eta)
                                {
                                    @AppFormatting.Iso(eta)
                                    <span class="muted activity-relative">@AppFormatting.RelativeToNow(eta, data.GeneratedAtUtc)</span>
                                }
                                else
                                {
                                    <span class="muted">No history yet</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (running.RunningCount > running.RunningSlices.Count)
        {
            <p class="muted">Showing @running.RunningSlices.Count of @running.RunningCount.ToString("N0", ci) running logical slice(s).</p>
        }
    }
</section>

<section class="card section-block">
    <div class="card-header">
        <div>
            <h2>Executions processed</h2>
            <p class="muted chart-help">Each execution unit contributes its latest succeeded or failed/dead-lettered outcome once.</p>
        </div>
    </div>
    <div class="summary-grid">
        @foreach (var (label, totals) in totalsCards)
        {
            <div class="stat-card">
                <span class="stat-label">@label</span>
                <span class="activity-total-value">@totals.Total.ToString("N0", ci)</span>
                <div class="activity-total-split">
                    <span class="badge badge-success">@totals.Succeeded.ToString("N0", ci) succeeded</span>
                    <span class="badge @(totals.Failed > 0 ? "badge-danger" : "badge-neutral")">@totals.Failed.ToString("N0", ci) failed</span>
                </div>
            </div>
        }
    </div>
</section>

<section class="card section-block">
    <div class="card-header">
        <div>
            <h2>Executions processed over time</h2>
            <p class="muted chart-help">Execution units by latest terminal completion, succeeded vs. failed/dead-lettered.</p>
        </div>
        <div class="range-picker">
            @foreach (var range in Model.RangeLinks)
            {
                <a class="btn small @(range.Key == Model.Range ? "primary" : null)" href="/activity?range=@range.Key">@range.Label</a>
            }
        </div>
    </div>
    <partial name="_ExecutionsProcessedChart" model="data.Chart" />
</section>
