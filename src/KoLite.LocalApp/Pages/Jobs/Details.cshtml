@page "/jobs/{jobId}"
@model KoLite.LocalApp.Pages.Jobs.DetailsModel
@{
    ViewData["Title"] = Model.Data?.Job.ActivityId ?? "Job";
}

@if (Model.Data is null || Model.Editor is null)
{
    <section class="card"><h1>Job not found</h1></section>
}
else
{
    var data = Model.Data;
    var charts = Model.Charts;
    var target = data.Definition.Target;
    var clusterHost = Uri.TryCreate(target.ClusterUri, UriKind.Absolute, out var clusterUriValue) ? clusterUriValue.Host : target.ClusterUri;
    var functionLink = AppFormatting.KustoShowFunctionLink(target.ClusterUri, target.Database, data.Definition.FunctionName);
    var tableLink = AppFormatting.KustoTablePreviewLink(target.ClusterUri, target.Database, data.Definition.OutputTable);
    var functionTooltip = $"Open Azure Data Explorer on {clusterHost} / {target.Database} and show the definition of function {data.Definition.FunctionName}. ADX does not auto-run commands, so select Run in the web explorer.";
    var tableTooltip = $"Open Azure Data Explorer on {clusterHost} / {target.Database} and preview the latest 10 rows of {data.Definition.OutputTable}.";
    <div class="page-heading">
        <div>
            <h1>@data.Job.ActivityId</h1>
            <p class="entity-links">
                <a class="entity-link" href="@functionLink" target="_blank" rel="noopener noreferrer" title="@functionTooltip">@data.Definition.FunctionName</a>
                <span class="entity-arrow" aria-hidden="true">-&gt;</span>
                <a class="entity-link" href="@tableLink" target="_blank" rel="noopener noreferrer" title="@tableTooltip">@data.Definition.OutputTable</a>
            </p>
            <p class="muted mono">id: @data.Job.JobId</p>
        </div>
        <partial name="_PausedIndicator" model="data" />
        <div class="button-row">
            <a class="btn" href="/">Back to jobs</a>
            <a class="btn" href="/catalog/@Uri.EscapeDataString(data.Job.JobId)/export">Export</a>
            <a class="btn" href="/catalog/@Uri.EscapeDataString(data.Job.JobId)/copy">Copy</a>
            @if (data.Lifecycle?.IsSoftDeleted == true)
            {
                <form method="post" action="/catalog/@Uri.EscapeDataString(data.Job.JobId)/restore" class="inline-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="expectedVersion" value="@data.Job.CatalogVersion" />
                    <input type="hidden" name="reason" value="Restored from details page" />
                    <button class="btn" type="submit">Restore</button>
                </form>
                <a class="btn danger" href="/catalog/@Uri.EscapeDataString(data.Job.JobId)/hard-delete">Hard delete</a>
            }
            else
            {
                @if (data.Job.IsEnabled)
                {
                    <form method="post" action="/catalog/@Uri.EscapeDataString(data.Job.JobId)/disable" class="inline-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="expectedVersion" value="@data.Job.CatalogVersion" />
                        <button class="btn" type="submit">Pause</button>
                    </form>
                }
                else
                {
                    <form method="post" action="/catalog/@Uri.EscapeDataString(data.Job.JobId)/enable" class="inline-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="expectedVersion" value="@data.Job.CatalogVersion" />
                        <button class="btn" type="submit">Resume</button>
                    </form>
                }
                <form method="post" action="/catalog/@Uri.EscapeDataString(data.Job.JobId)/soft-delete" class="inline-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="expectedVersion" value="@data.Job.CatalogVersion" />
                    <input type="hidden" name="reason" value="Soft deleted from details page" />
                    <button class="btn danger" type="submit">Soft delete</button>
                </form>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.CatalogConflictMessage))
    {
        <div class="alert warning" role="alert">@Model.CatalogConflictMessage</div>
    }

    @if (Model.Status is { ShowCompleteness: true, GapCount: > 0 } gapStatus)
    {
        <div class="alert warning" role="alert">
            This job has @gapStatus.GapCount unaddressed dead-lettered slice(s), so its history is incomplete.
            Rerun or repair them to close the gaps, or set <code>healthPolicy</code> to <code>recent</code> if gaps are acceptable for this job.
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(data.Job.Description))
    {
        <section class="card job-description-card" data-job-description>
            <div class="card-header">
                <h2>Description</h2>
                <span class="muted">Markdown</span>
            </div>
            <div class="markdown-body job-description-output" data-job-description-output hidden></div>
            <div data-job-description-source hidden>@data.Job.Description</div>
            <noscript><pre class="markdown-fallback">@data.Job.Description</pre></noscript>
        </section>
    }

    <partial name="_CatchUpSummary" model="data.CatchUp" />

    <div class="job-tabs" data-tabs>
        <nav class="tab-list" role="tablist" aria-label="Job details sections">
            <a id="slice-history-tab" class="tab-link active" href="#slice-history" role="tab" aria-controls="slice-history" aria-selected="true">Slice history</a>
            <a id="definition-tab" class="tab-link" href="#definition" role="tab" aria-controls="definition" aria-selected="false">Job definition</a>
            <a id="dependencies-tab" class="tab-link" href="#dependencies" role="tab" aria-controls="dependencies" aria-selected="false">Dependencies</a>
            <a id="operations-tab" class="tab-link" href="#operations" role="tab" aria-controls="operations" aria-selected="false">Operations</a>
            <a id="change-history-tab" class="tab-link" href="#change-history" role="tab" aria-controls="change-history" aria-selected="false">Change history</a>
        </nav>

        <section id="slice-history" class="tab-panel active" role="tabpanel" aria-labelledby="slice-history-tab">
            <section class="card">
                <div class="card-header">
                    <div>
                        <h2>Slice history</h2>
                        <p class="muted">Each cell is one scheduled slice. Colors distinguish completed, completed after retry, queued, running, waiting, failed, and missing work. A "stalled (orphaned lease)" key also appears whenever a slice in the window is stalled.</p>
                    </div>
                    <a class="btn small" href="/jobs/@Uri.EscapeDataString(data.Job.JobId)/history">Open full history</a>
                </div>
                <partial name="_SliceHistory" model="data.SliceHistory" />
            </section>

            @if (charts is not null)
            {
                <section class="card job-execution-charts">
                    <div class="card-header">
                        <div>
                            <h2>Execution charts</h2>
                            <p class="muted chart-help">Per-job execution results are grouped by completion time. LeaseLost is shown in the Error bucket because it is an operational failure that should remain visible.</p>
                        </div>
                        <div class="range-picker" aria-label="Chart range">
                            @foreach (var range in Model.RangeLinks)
                            {
                                <a class="btn small @(range.Key == Model.Range ? "primary" : null)" aria-current="@(range.Key == Model.Range ? "true" : null)" href="/jobs/@Uri.EscapeDataString(data.Job.JobId)?range=@range.Key#slice-history">@range.Label</a>
                            }
                        </div>
                    </div>
                    <div class="chart-grid">
                        <div>
                            <h3>Query Results by Time of Execution</h3>
                            <partial name="_JobAttemptResultChart" model="charts.AttemptResults" />
                        </div>
                        <div>
                            <h3>Successful Query Duration by Time of Execution</h3>
                            <p class="muted chart-help">Uses query duration from attempt metrics when present; otherwise uses successful attempt duration from started_at_utc to completed_at_utc.</p>
                            <partial name="_JobSuccessfulDurationChart" model="charts.SuccessfulDurations" />
                        </div>
                    </div>
                </section>
            }
        </section>

        <section id="definition" class="tab-panel" role="tabpanel" aria-labelledby="definition-tab">
            <div class="section-title">
                <h2>Job definition</h2>
                <p class="muted">Edit the schedule fields or the raw schedule JSON for this job.</p>
            </div>
            <partial name="_ScheduleEditor" model="Model.Editor" />
        </section>

        <section id="dependencies" class="tab-panel" role="tabpanel" aria-labelledby="dependencies-tab">
            <section class="card">
                <div class="card-header">
                    <div>
                        <h2>Dependencies</h2>
                        <p class="muted">This job (outlined) with its full upstream and downstream dependency chain, colored by current status. Click any node to open that job.</p>
                    </div>
                </div>
                <partial name="_DependencyGraph" model="new DependencyGraphPanelViewModel(Model.DependencyGraph, new[] { data.Job.JobId })" />
            </section>
        </section>

        <section id="operations" class="tab-panel" role="tabpanel" aria-labelledby="operations-tab">
            <div class="section-title">
                <h2>Operations</h2>
                <p class="muted">Recent execution attempts, state events, and logs for this job.</p>
            </div>
            <div class="card analyze-failures-card" data-analyze-card data-job-id="@data.Job.JobId">
                <div class="card-header">
                    <h3>Analyze failures with Copilot</h3>
                    <button type="button" class="btn primary" data-analyze-failures>Analyze failures</button>
                </div>
                @Html.AntiForgeryToken()
                <p class="muted">Sends this job's recent failure evidence (secret-sanitized) to GitHub Copilot CLI in no-tools mode and shows a root-cause analysis. Install the <code>copilot</code> command and run <code>copilot login</code> once. Nothing is sent until you select <em>Analyze failures</em>.</p>
                <div class="analyze-status" data-analyze-status hidden></div>
                <div class="analyze-output markdown-body" data-analyze-output hidden></div>
            </div>
            <div class="grid-two">
            <div class="card">
                <div class="card-header">
                    <h3>Recent attempts</h3>
                    <span class="muted">@data.RecentAttempts.Count row(s)</span>
                </div>
                @if (data.RecentAttempts.Count == 0)
                {
                    <p class="empty">No attempts recorded.</p>
                }
                else
                {
                    <div class="table-wrap scroll-panel">
                        <table class="ko-table compact">
                            <thead><tr><th>Slice</th><th>Chunk</th><th>Attempt</th><th>Status</th><th>Completed</th><th>Error</th></tr></thead>
                            <tbody>
                            @foreach (var attempt in data.RecentAttempts)
                            {
                                <tr>
                                    <td><a href="/jobs/@Uri.EscapeDataString(data.Job.JobId)/slices?start=@Uri.EscapeDataString(AppFormatting.Iso(attempt.SliceStartUtc))&end=@Uri.EscapeDataString(AppFormatting.Iso(attempt.SliceEndUtc))">@AppFormatting.Iso(attempt.SliceStartUtc)</a></td>
                                    <td>@(attempt.ChunkId is null ? "-" : $"{attempt.ChunkId}/{attempt.TotalChunks}")</td>
                                    <td>@attempt.Attempt</td>
                                    <td><span class="badge @AppFormatting.BadgeCss(attempt.Status)">@attempt.Status</span></td>
                                    <td>@AppFormatting.Local(attempt.CompletedAtUtc)</td>
                                    <td><span class="text-truncate" title="@attempt.ErrorMessage">@attempt.ErrorMessage</span></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="card">
                <div class="card-header">
                    <h3>Recent logs and events</h3>
                    <span class="muted">Latest activity</span>
                </div>
                @if (data.RecentLogs.Count == 0 && data.RecentEvents.Count == 0)
                {
                    <p class="empty">No logs or events recorded.</p>
                }
                else
                {
                    <div class="scroll-panel">
                        <ul class="plain-list dense-list">
                            @foreach (var evt in data.RecentEvents)
                            {
                                <li><span class="badge">@evt.EventType</span> @AppFormatting.Iso(evt.SliceStartUtc) <span class="muted">@AppFormatting.Local(evt.RecordedAtUtc)</span> @evt.Reason</li>
                            }
                            @foreach (var log in data.RecentLogs)
                            {
                                <li><span class="badge">@log.Level</span> @log.Message <span class="muted">@AppFormatting.Local(log.RecordedAtUtc)</span></li>
                            }
                        </ul>
                    </div>
                }
            </div>
            </div>
        </section>

        <section id="change-history" class="tab-panel" role="tabpanel" aria-labelledby="change-history-tab">
            <div class="section-title">
                <h2>Change history</h2>
                <p class="muted">Catalog history tracks schedule definition versions and highlights JSON changes between versions.</p>
            </div>
            <div class="card">
                <div class="card-header">
                    <h3>Catalog definition history</h3>
                    <span class="muted">@data.CatalogHistory.Count version(s)</span>
                </div>
                @if (data.CatalogHistory.Count == 0)
                {
                    <p class="empty">No catalog history recorded.</p>
                }
                else
                {
                    <ul class="plain-list catalog-history-list">
                        @foreach (var history in data.CatalogHistory)
                        {
                            <li>
                                <div class="catalog-history-entry-header">
                                    <strong>Catalog version @(history.CatalogVersion)</strong>
                                    <span class="badge">@history.EventType</span>
                                    <span class="muted">@AppFormatting.Local(history.RecordedAtUtc)</span>
                                    @if (!string.IsNullOrWhiteSpace(history.Actor))
                                    {
                                        <span class="muted">by @history.Actor</span>
                                    }
                                </div>
                                @if (history.IsInitialDefinition)
                                {
                                    <p class="muted catalog-history-note">Initial schedule definition.</p>
                                }
                                else if (!history.HasScheduleChanges)
                                {
                                    <p class="muted catalog-history-note">No schedule JSON changes.</p>
                                }
                                else
                                {
                                    <div class="table-wrap">
                                        <table class="ko-table compact catalog-diff-table">
                                            <thead>
                                                <tr>
                                                    <th>Path</th>
                                                    <th>Change</th>
                                                    <th>Previous</th>
                                                    <th>Current</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            @foreach (var diff in history.DiffRows)
                                            {
                                                <tr>
                                                    <td class="catalog-diff-path"><code>@diff.Path</code></td>
                                                    <td><span class="badge">@diff.ChangeType</span></td>
                                                    <td class="catalog-diff-value">@(diff.PreviousValue ?? "-")</td>
                                                    <td class="catalog-diff-value">@(diff.CurrentValue ?? "-")</td>
                                                </tr>
                                            }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>
    </div>
}
