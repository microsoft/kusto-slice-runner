@page "/jobs/{jobId}/slices"
@model KoLite.LocalApp.Pages.Jobs.SliceModel
@{
    ViewData["Title"] = "Slice detail";
}

@if (Model.Data is null)
{
    <section class="card"><h1>Slice not found</h1></section>
}
else
{
    <div class="page-heading">
        <div>
            <h1>Slice detail: @Model.Data.Job.ActivityId</h1>
            <p class="muted">@Model.Data.Job.ActivityId: @AppFormatting.Iso(Model.Data.SliceStartUtc) - @AppFormatting.Iso(Model.Data.SliceEndUtc)</p>
        </div>
        <div class="button-row">
            <a class="btn primary" href="/jobs/@Uri.EscapeDataString(Model.Data.Job.JobId)/rerun?start=@Uri.EscapeDataString(AppFormatting.DateTimeInputUtc(Model.Data.SliceStartUtc))&end=@Uri.EscapeDataString(AppFormatting.DateTimeInputUtc(Model.Data.SliceEndUtc))">Repair or rerun this slice</a>
            <a class="btn" href="/jobs/@Uri.EscapeDataString(Model.Data.Job.JobId)">Back to details</a>
        </div>
    </div>
    @if (Model.StatusMessage is not null)
    {
        <div class="alert success">@Model.StatusMessage</div>
    }
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert danger">@Model.ErrorMessage</div>
    }
    @if (Model.Data.IsOrphaned)
    {
        <section class="card">
            <div class="card-header"><h2>Orphaned lease</h2><span class="badge badge-warning">Stalled</span></div>
            <p class="muted">This slice is still held by a lease whose lock has expired without recording a terminal result. A previous attempt faulted or its process stopped after the lease was taken. The output may already be in Kusto; re-running is idempotent (ingest-by) and will not duplicate it.</p>
            @if (Model.Data.Job.IsEnabled)
            {
                <form method="post" action="/jobs/@Uri.EscapeDataString(Model.Data.Job.JobId)/slices?handler=Recover">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="start" value="@AppFormatting.Iso(Model.Data.SliceStartUtc)" />
                    <input type="hidden" name="end" value="@AppFormatting.Iso(Model.Data.SliceEndUtc)" />
                    <button class="btn primary" type="submit">Recover expired lease (re-queue)</button>
                </form>
            }
            else
            {
                <div class="alert warning">The job is paused or deleted, so this orphaned slice will not recover automatically. Resume the job to let it recover on the next dispatch.</div>
            }
        </section>
    }
    <section class="summary-grid">
        <div class="stat-card"><span class="stat-label">Status</span><strong>@(Model.Data.IsOrphaned ? "Stalled (orphaned lease)" : (Model.Data.Status?.Status ?? "Missing"))</strong></div>
        <div class="stat-card"><span class="stat-label">Attempt</span><strong>@(Model.Data.Status?.Attempt ?? 0)</strong></div>
        <div class="stat-card"><span class="stat-label">Queue rows</span><strong>@Model.Data.QueueItems.Count</strong></div>
        <div class="stat-card"><span class="stat-label">Attempts</span><strong>@Model.Data.Attempts.Count</strong></div>
    </section>
    @if (Model.Data.Chunks.Count > 0)
    {
        <section class="card">
            <div class="card-header"><h2>Chunks</h2><span class="muted">@Model.Data.Chunks.Count execution units</span></div>
            <table class="ko-table compact">
                <thead><tr><th>Chunk</th><th>Status</th><th>Attempt</th><th>Lease owner</th><th>Lease expires</th><th>Error</th></tr></thead>
                <tbody>
                @foreach (var chunk in Model.Data.Chunks)
                {
                    <tr>
                        <td>@chunk.ChunkId / @chunk.TotalChunks</td>
                        <td><span class="badge @AppFormatting.BadgeCss(chunk.Status.ToString())">@chunk.Status</span></td>
                        <td>@chunk.Attempt</td>
                        <td>@chunk.LeaseOwner</td>
                        <td>@AppFormatting.Iso(chunk.LeaseExpiresAtUtc)</td>
                        <td>@chunk.LastErrorMessage</td>
                    </tr>
                }
                </tbody>
            </table>
        </section>
    }
    <section class="grid-two">
        <div class="card">
            <div class="card-header"><h2>Attempts</h2></div>
            @if (Model.Data.Attempts.Count == 0)
            {
                <p class="empty">No attempts recorded.</p>
            }
            else
            {
                <table class="ko-table compact">
                    <thead><tr><th>Chunk</th><th>Attempt</th><th>Status</th><th>Worker</th><th>Started</th><th>Completed</th><th>Error</th></tr></thead>
                    <tbody>
                    @foreach (var attempt in Model.Data.Attempts)
                    {
                        <tr>
                            <td>@(attempt.ChunkId is null ? "-" : $"{attempt.ChunkId}/{attempt.TotalChunks}")</td>
                            <td>@attempt.Attempt</td>
                            <td><span class="badge @AppFormatting.BadgeCss(attempt.Status)">@attempt.Status</span></td>
                            <td>@attempt.WorkerId</td>
                            <td>@AppFormatting.Iso(attempt.StartedAtUtc)</td>
                            <td>@AppFormatting.Iso(attempt.CompletedAtUtc)</td>
                            <td>@attempt.ErrorMessage</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
        <div class="card">
            <div class="card-header"><h2>Events and logs</h2></div>
            <ul class="plain-list">
                @foreach (var evt in Model.Data.ChunkEvents)
                {
                    <li data-chunk-event="@evt.ChunkId"><span class="badge">@evt.Status</span> <strong>Chunk @evt.ChunkId/@evt.TotalChunks</strong> <span class="muted">@AppFormatting.Iso(evt.RecordedAtUtc)</span> @evt.Reason</li>
                }
                @foreach (var evt in Model.Data.Events)
                {
                    <li><span class="badge">@evt.EventType</span> <span class="muted">@AppFormatting.Iso(evt.RecordedAtUtc)</span> @evt.Reason</li>
                }
                @foreach (var log in Model.Data.Logs)
                {
                    <li data-chunk-log="@log.ChunkId"><span class="badge">@log.Level</span> @if (log.ChunkId is { } chunkId && log.TotalChunks is { } totalChunks) { <strong>Chunk @chunkId/@totalChunks</strong> } <span class="muted">@AppFormatting.Iso(log.RecordedAtUtc)</span> @log.Message</li>
                }
            </ul>
        </div>
    </section>
    <section class="card">
        <div class="card-header"><h2>Queue rows</h2></div>
        @if (Model.Data.QueueItems.Count == 0)
        {
            <p class="empty">No queue rows for this slice.</p>
        }
        else
        {
            <table class="ko-table compact">
                <thead><tr><th>Chunk</th><th>Queue item</th><th>Queue</th><th>State</th><th>Available</th><th>Locked by</th><th>Attempts</th></tr></thead>
                <tbody>
                @foreach (var item in Model.Data.QueueItems)
                {
                    <tr><td>@(item.ChunkId is null ? "-" : $"{item.ChunkId}/{item.TotalChunks}")</td><td>@item.QueueItemId</td><td>@item.QueueName</td><td>@item.State</td><td>@AppFormatting.Iso(item.AvailableAtUtc)</td><td>@item.LockedBy</td><td>@item.Attempts/@item.MaxAttempts</td></tr>
                }
                </tbody>
            </table>
        }
    </section>
}
