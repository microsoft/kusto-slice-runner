@page "/jobs/{jobId}/history"
@model KoLite.LocalApp.Pages.Jobs.HistoryModel
@{
    ViewData["Title"] = "Slice History";
}

@if (Model.Data is null)
{
    <section class="card"><h1>Job not found</h1></section>
}
else
{
    <div class="page-heading">
        <div>
            <h1>Slice History: @Model.Data.Job.ActivityId</h1>
            <p class="muted">SQLite-backed slice status timeline.</p>
        </div>
        <partial name="_PausedIndicator" model="Model.Data" />
        <a class="btn" href="/jobs/@Uri.EscapeDataString(Model.Data.Job.JobId)">Back to details</a>
    </div>
    <section class="card">
        @if (Model.RangeError is not null)
        {
            <div class="alert danger">@Model.RangeError</div>
        }
        <form method="get" action="/jobs/@Uri.EscapeDataString(Model.Data.Job.JobId)/history" class="range-picker">
            <label>
                <span>Start (UTC)</span>
                <input type="datetime-local" name="from" value="@Model.FromInput" />
            </label>
            <label>
                <span>End (UTC)</span>
                <input type="datetime-local" name="to" value="@Model.ToInput" />
            </label>
            <button class="btn primary" type="submit">Apply range</button>
            <a class="btn" href="/jobs/@Uri.EscapeDataString(Model.Data.Job.JobId)/history">Clear</a>
        </form>
        <p class="muted">Dates are interpreted as UTC. The displayed start is expanded back to the containing row boundary so each row stays fully binned.</p>
        @if (Model.Data.SliceHistoryRange.IsLimited)
        {
            <div class="alert warning">
                Selected range is too large for one page; showing the latest @Model.Data.SliceHistoryRange.CellLimit slices from @AppFormatting.Iso(Model.Data.SliceHistoryRange.DisplayStartUtc) to @AppFormatting.Iso(Model.Data.SliceHistoryRange.DisplayEndUtc). Narrow the range to inspect earlier slices.
            </div>
        }
        else
        {
            <p class="muted">Showing @AppFormatting.Iso(Model.Data.SliceHistoryRange.DisplayStartUtc) to @AppFormatting.Iso(Model.Data.SliceHistoryRange.DisplayEndUtc).</p>
        }
        <partial name="_SliceHistory" model="Model.Data.SliceHistory" />
    </section>
}
