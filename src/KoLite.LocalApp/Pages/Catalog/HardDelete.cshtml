@page "/jobs/{jobId:guid}/hard-delete"
@model KoLite.LocalApp.Pages.Catalog.HardDeleteModel
@{
    ViewData["Title"] = "Hard delete";
}

<div class="page-heading">
    <div>
        <h1>Hard delete @Model.DisplayName</h1>
        <p class="muted mono">id: @Model.JobId</p>
        <p class="muted">This permanently purges the local catalog row, queue rows, slice state, attempts, and repair rows for this job.</p>
    </div>
    <a class="btn" href="/">Back to jobs</a>
</div>

@if (Model.Result is not null)
{
    <section class="card">
        <h2>Hard delete completed</h2>
        <p>Purge run <code>@Model.Result.PurgeRunId</code> deleted @Model.Result.DeletedJobs job row(s), @Model.Result.DeletedQueueRows queue row(s), @Model.Result.DeletedStateRows state row(s), and @Model.Result.DeletedRepairBatches repair batch row(s).</p>
    </section>
}
else
{
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert danger">@Model.ErrorMessage</div>
    }
    <section class="card form-card">
        <h2>Confirm hard delete</h2>
        <p>Hard delete is allowed only after the job is disabled or soft-deleted and no active work is queued, leased, or running.</p>
        <form method="post" action="/jobs/@Uri.EscapeDataString(Model.JobId)/hard-delete">
            @Html.AntiForgeryToken()
            <label>Type <code>DELETE @Model.DisplayName</code><input name="confirmation" autocomplete="off" /></label>
            <label>Reason<textarea name="reason" rows="3">Hard deleted from web UI</textarea></label>
            <button class="btn danger" type="submit" data-confirm-text="DELETE @Model.DisplayName">Hard delete permanently</button>
        </form>
    </section>
}
