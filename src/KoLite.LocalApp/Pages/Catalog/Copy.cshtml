@page "/jobs/{jobId:guid}/copy"
@model KoLite.LocalApp.Pages.Catalog.CopyModel
@{
    ViewData["Title"] = "Copy job";
}

@if (Model.Editor is null)
{
    <section class="card"><h1>Job not found</h1></section>
}
else
{
    <div class="page-heading">
        <div>
            <h1>Copy job</h1>
            <p class="muted">Create a new job using an existing schedule as a starting point.</p>
        </div>
        <a class="btn" href="/">Back to jobs</a>
    </div>
    <partial name="_ScheduleEditor" model="Model.Editor" />
}
