{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "KoLite.LocalApp": "Information"
    }
  },
  "AllowedHosts": "*",
  "KoLite": {
    "Retention": {
      "Enabled": true,
      "WindowDays": 30,
      "Interval": "06:00:00",
      "InitialDelay": "00:02:00",
      "BatchSize": 2000
    }
  }
}
