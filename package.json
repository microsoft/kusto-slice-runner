{
  "name": "ko-lite",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first KO Lite dashboard assets.",
  "scripts": {
    "copy:chartjs": "node ./scripts/copy-chartjs.mjs",
    "copy:cytoscape": "node ./scripts/copy-cytoscape.mjs",
    "copy:marked": "node ./scripts/copy-marked.mjs",
    "screenshots": "pwsh -NoProfile -File ./scripts/Capture-DocumentationScreenshots.ps1",
    "test:js": "node ./scripts/test-site-routes.mjs",
    "postinstall": "npm run copy:chartjs && npm run copy:cytoscape && npm run copy:marked"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "chart.js": "^4.5.1",
    "cytoscape": "^3.34.3",
    "cytoscape-dagre": "^4.0.1",
    "marked": "^18.0.12"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "playwright": "1.60.0"
  }
}
